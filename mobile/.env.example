# Copy to .env (Expo reads EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=CHANGE_ME_NATIVE_APP_CLIENT_ID
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.opesfuel.com/v1
# Development only: shows demo role buttons with built-in sample data. NEVER set to true in a store build.
EXPO_PUBLIC_DEMO_MODE=false
