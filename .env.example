# GEMINI_API_KEY: Optional server runtime key managed by AI Studio Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL injected by AI Studio at runtime.
APP_URL="MY_APP_URL"

# Web Frontend -> Java 25 Spring Boot API Base URL (leave empty to use live in-browser preview adapter)
VITE_API_BASE_URL=""

# Auth0 Frontend Configuration (OIDC PKCE; omit to use instant role-switch demo mode)
VITE_AUTH0_DOMAIN=""
VITE_AUTH0_CLIENT_ID=""
VITE_AUTH0_AUDIENCE="https://api.opesfuel.com/v1"

# Java 25 Spring Boot Backend (PostgreSQL + Auth0 Resource Server)
SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/opesfuel"
SPRING_DATASOURCE_USERNAME="opesfuel_app"
SPRING_DATASOURCE_PASSWORD="CHANGE_ME_LOCAL_DEV_ONLY"
AUTH0_ISSUER_URI="https://your-tenant.auth0.com/"
AUTH0_AUDIENCE="https://api.opesfuel.com/v1"

# Expo Mobile App
EXPO_PUBLIC_API_URL="http://localhost:8080/api/v1"
EXPO_PUBLIC_AUTH0_DOMAIN=""
EXPO_PUBLIC_AUTH0_CLIENT_ID=""

# Cameroon Mobile Money (MTN MoMo & Orange Money WebPay)
OPESFUEL_MTN_BASE_URL="https://sandbox.momodeveloper.mtn.com"
OPESFUEL_MTN_TARGET_ENV="sandbox"
OPESFUEL_MTN_API_USER=""
OPESFUEL_MTN_API_KEY=""
OPESFUEL_MTN_COLLECTION_SUBSCRIPTION_KEY=""
OPESFUEL_MTN_DISBURSEMENT_SUBSCRIPTION_KEY=""
OPESFUEL_MTN_CALLBACK_URL=""
OPESFUEL_ORANGE_BASE_URL="https://api.orange.com"
OPESFUEL_ORANGE_ENV="dev"
OPESFUEL_ORANGE_CLIENT_ID=""
OPESFUEL_ORANGE_CLIENT_SECRET=""
OPESFUEL_ORANGE_MERCHANT_KEY=""
OPESFUEL_ORANGE_RETURN_URL="http://localhost:3000/#/app/admin"
OPESFUEL_ORANGE_CANCEL_URL="http://localhost:3000/#/app/admin"
OPESFUEL_ORANGE_NOTIF_URL=""

# Real Outbound Email / SMS / WhatsApp
OPESFUEL_MAIL_PROVIDER="LOG_ONLY"
OPESFUEL_MAIL_FROM="noreply@opesfuel.com"
OPESFUEL_MAIL_API_KEY=""
OPESFUEL_SMTP_HOST=""
OPESFUEL_SMTP_PORT="587"
OPESFUEL_SMTP_USERNAME=""
OPESFUEL_SMTP_PASSWORD=""
OPESFUEL_SMS_PROVIDER="LOG_ONLY"
OPESFUEL_AT_USERNAME=""
OPESFUEL_AT_API_KEY=""
OPESFUEL_TWILIO_ACCOUNT_SID=""
OPESFUEL_TWILIO_AUTH_TOKEN=""
OPESFUEL_TWILIO_FROM=""
OPESFUEL_WHATSAPP_PROVIDER="LOG_ONLY"
OPESFUEL_WHATSAPP_PHONE_NUMBER_ID=""
OPESFUEL_WHATSAPP_ACCESS_TOKEN=""

