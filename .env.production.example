# OpesFuel Production VPS Environment Configuration
# Copy to .env on your VPS and replace ALL placeholder secrets before running:
#   docker compose -f docker-compose.prod.yml up -d --build

POSTGRES_DB=opesfuel
POSTGRES_USER=opesfuel_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# Auth0 OIDC / RBAC JWT Resource Server
AUTH0_ISSUER_URI=https://your-tenant.auth0.com/
AUTH0_AUDIENCE=https://api.opesfuel.com/v1
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=CHANGE_ME_AUTH0_SPA_CLIENT_ID

# Public Domains & CORS
PUBLIC_API_BASE_URL=https://api.yourdomain.com
OPESFUEL_CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# AES-256-GCM Master Key for encrypting webhook HMAC secrets at rest (min 32 random chars)
OPESFUEL_ENCRYPTION_KEY=CHANGE_ME_32_PLUS_CHAR_RANDOM_ENCRYPTION_KEY

# Optional: Google Gemini API Key for Paid AI Copilot
GEMINI_API_KEY=
OPESFUEL_AI_MODEL=gemini-2.5-flash

# Fiscal & Alert Configuration
OPESFUEL_VAT_RATE=0.1925
OPESFUEL_ALERTS_WEBHOOK_URL=
