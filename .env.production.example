# OpesFuel Production VPS Environment Configuration
# Copy to .env on your VPS and replace ALL placeholder secrets before running:
#   docker compose -f docker-compose.prod.yml up -d --build

POSTGRES_DB=opesfuel
POSTGRES_USER=opesfuel_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# Auth0 OIDC / RBAC JWT Resource Server
AUTH0_ISSUER_URI=https://your-tenant.auth0.com/
AUTH0_AUDIENCE=https://api.opesfuel.com/v1
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=CHANGE_ME_AUTH0_SPA_CLIENT_ID

# Public Domains & CORS
PUBLIC_API_BASE_URL=https://api.yourdomain.com
OPESFUEL_CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# AES-256-GCM Master Key for encrypting webhook HMAC secrets at rest (min 32 random chars)
OPESFUEL_ENCRYPTION_KEY=CHANGE_ME_32_PLUS_CHAR_RANDOM_ENCRYPTION_KEY

# Optional: Google Gemini API Key for Paid AI Copilot
GEMINI_API_KEY=
OPESFUEL_AI_MODEL=gemini-2.5-flash

# Fiscal & Alert Configuration
OPESFUEL_VAT_RATE=0.1925
OPESFUEL_ALERTS_WEBHOOK_URL=

# Cameroon Mobile Money — MTN MoMo Open API (sandbox | mtncameroon)
OPESFUEL_MTN_BASE_URL=https://proxy.momoapi.mtn.com
OPESFUEL_MTN_TARGET_ENV=mtncameroon
OPESFUEL_MTN_API_USER=
OPESFUEL_MTN_API_KEY=
OPESFUEL_MTN_COLLECTION_SUBSCRIPTION_KEY=
OPESFUEL_MTN_DISBURSEMENT_SUBSCRIPTION_KEY=
OPESFUEL_MTN_CALLBACK_URL=https://api.yourdomain.com/api/v1/public/webhooks/momo/mtn

# Cameroon Mobile Money — Orange Money WebPay API v1 (dev | prod)
OPESFUEL_ORANGE_BASE_URL=https://api.orange.com
OPESFUEL_ORANGE_ENV=prod
OPESFUEL_ORANGE_CLIENT_ID=
OPESFUEL_ORANGE_CLIENT_SECRET=
OPESFUEL_ORANGE_MERCHANT_KEY=
OPESFUEL_ORANGE_RETURN_URL=https://app.yourdomain.com/#/app/admin
OPESFUEL_ORANGE_CANCEL_URL=https://app.yourdomain.com/#/app/admin
OPESFUEL_ORANGE_NOTIF_URL=https://api.yourdomain.com/api/v1/public/webhooks/momo/orange
OPESFUEL_ORANGE_LANG=fr

# Real Outbound Email (SMTP | RESEND | LOG_ONLY)
OPESFUEL_MAIL_PROVIDER=SMTP
OPESFUEL_MAIL_FROM=noreply@yourdomain.com
OPESFUEL_MAIL_API_KEY=
OPESFUEL_SMTP_HOST=
OPESFUEL_SMTP_PORT=587
OPESFUEL_SMTP_USERNAME=
OPESFUEL_SMTP_PASSWORD=
OPESFUEL_SMTP_STARTTLS=true
OPESFUEL_SMTP_SSL=false

# Real Outbound SMS (AFRICAS_TALKING | TWILIO | LOG_ONLY)
OPESFUEL_SMS_PROVIDER=AFRICAS_TALKING
OPESFUEL_AT_USERNAME=
OPESFUEL_AT_API_KEY=
OPESFUEL_AT_FROM=OPESFUEL
OPESFUEL_TWILIO_ACCOUNT_SID=
OPESFUEL_TWILIO_AUTH_TOKEN=
OPESFUEL_TWILIO_FROM=

# Real Outbound WhatsApp (META_CLOUD | LOG_ONLY)
OPESFUEL_WHATSAPP_PROVIDER=META_CLOUD
OPESFUEL_WHATSAPP_PHONE_NUMBER_ID=
OPESFUEL_WHATSAPP_ACCESS_TOKEN=

