  email info@opesware.com
}

{$OPESFUEL_DOMAIN:app.opesfuel.com} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
    -Server
  }

  handle /api/* {
    reverse_proxy opesfuel-backend:8080
  }

  handle {
    reverse_proxy opesfuel-web:3000
  }
}

{$OPESFUEL_API_DOMAIN:api.opesfuel.com} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    -Server
  }

  reverse_proxy opesfuel-backend:8080
}

{$OPESFUEL_MCP_DOMAIN:mcp.opesfuel.com} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    -Server
  }

  reverse_proxy opesfuel-mcp:8787
}

{$OPESFUEL_DEMO_DOMAIN:demo.opesfuel.com} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    -Server
  }

  reverse_proxy opesfuel-demo:3000
}
