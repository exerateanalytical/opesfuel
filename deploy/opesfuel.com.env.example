# OpesFuel production environment for opesfuel.com
# Copy to .env on the server (same folder as docker-compose.prod.yml) and replace every CHANGE_ME.
# Never commit the filled-in file.

# ---- Domains (Caddy issues HTTPS certificates for these automatically) ----
OPESFUEL_DOMAIN=opesfuel.com
OPESFUEL_API_DOMAIN=api.opesfuel.com
OPESFUEL_DEMO_DOMAIN=demo.opesfuel.com
OPESFUEL_MCP_DOMAIN=mcp.opesfuel.com

PUBLIC_API_BASE_URL=https://api.opesfuel.com
OPESFUEL_CORS_ALLOWED_ORIGINS=https://opesfuel.com,https://demo.opesfuel.com
VITE_DEMO_URL=https://demo.opesfuel.com
MCP_PUBLIC_URL=https://mcp.opesfuel.com

# ---- Database ----
POSTGRES_DB=opesfuel
POSTGRES_USER=opesfuel_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# ---- Identity provider: Keycloak (self-hosted OpenID Connect) ----
# Realm URL exactly as Keycloak reports it as "issuer": https, includes /realms/<name>, NO trailing slash.
# Check: curl -s <issuer>/.well-known/openid-configuration  -> the "issuer" value must equal OIDC_ISSUER_URI character for character.
OIDC_ISSUER_URI=https://CHANGE_ME-keycloak-host/realms/opesfuel
VITE_OIDC_ISSUER=https://CHANGE_ME-keycloak-host/realms/opesfuel
VITE_OIDC_CLIENT_ID=opesfuel-web
# Audience the backend requires in access tokens; the Keycloak client must add it with an "Audience" mapper (deploy/keycloak_setup.py does).
OIDC_AUDIENCE=https://api.opesfuel.com/v1

# ---- Platform admin login (REQUIRED): the verified email you will sign in with ----
OPESFUEL_BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME@yourmail.com

# ---- Secrets (generate: openssl rand -hex 32) ----
OPESFUEL_ENCRYPTION_KEY=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS
# Only needed if you ever use Auth0 instead of Keycloak (Auth0 post-login Action). Leave empty with Keycloak.
OPESFUEL_AUTH0_ACTION_SECRET=

# ---- SaaS policy (production-safe defaults) ----
OPESFUEL_DEMO_TENANT_ID=ten_opes_cm
OPESFUEL_DEMO_READ_ONLY=true
OPESFUEL_ENFORCE_TRIAL_LOCK=true
OPESFUEL_ALLOW_DEFAULT_TENANT_FALLBACK=false

# ---- Mobile Money (fill when you have the provider credentials) ----
OPESFUEL_MTN_CALLBACK_URL=https://api.opesfuel.com/api/v1/public/webhooks/momo/mtn
OPESFUEL_ORANGE_RETURN_URL=https://opesfuel.com/#/app/admin
OPESFUEL_ORANGE_CANCEL_URL=https://opesfuel.com/#/app/admin
OPESFUEL_ORANGE_NOTIF_URL=https://api.opesfuel.com/api/v1/public/webhooks/momo/orange

# ---- Outbound email (set provider + credentials; see docs/PAYMENTS_MESSAGING.md) ----
OPESFUEL_MAIL_PROVIDER=LOG_ONLY
OPESFUEL_MAIL_FROM=noreply@opesfuel.com

# ---- Optional connector for Claude/ChatGPT (start with --profile mcp) ----
MCP_ENABLE_WRITES=false
